# Copiez ce fichier en .env et remplissez-le. .env ne se commite JAMAIS.

# Option A (Ollama installé sur le PC, application dans Docker) :
OLLAMA_URL=http://host.docker.internal:11434
# Sans Docker (uvicorn main:app --reload --env-file .env), Ollama sur le même PC :
# OLLAMA_URL=http://localhost:11434
# Option B (Ollama dans le compose) :
# OLLAMA_URL=http://ollama:11434

# Qui sert le modèle : ollama (votre PC) | ovh | github | groq | mistral | google
# (voir fournisseurs.py : où partent les données, et ce qu'il faut pour chacun)
FOURNISSEUR=ollama

# Le modèle. Avec Ollama : celui choisi selon votre carte (voir les consignes).
# Vide = le modèle par défaut du fournisseur.
MODELE=qwen2.5:3b

# La clé du fournisseur en ligne (inutile pour ollama, facultative pour ovh).
# Elle reste ICI, côté serveur : jamais dans le dépôt, jamais dans la page web.
CLE_API=

# 8 caractères au moins. Vous le donnerez à l'enseignant, à personne d'autre.
CODE_ACCES=

MAX_CARACTERES=2000
REQUETES_PAR_MINUTE=10
TEMPERATURE=0.2
DELAI_SECONDES=120
