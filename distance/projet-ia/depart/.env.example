# Copiez ce fichier en .env et remplissez-le. .env ne se commite JAMAIS.

# Option A (Ollama installé sur le PC) :
OLLAMA_URL=http://host.docker.internal:11434
# Option B (Ollama dans le compose) :
# OLLAMA_URL=http://ollama:11434

# Le modèle choisi selon votre carte (voir les consignes) :
MODELE=qwen2.5:3b

# 8 caractères au moins. Vous le donnerez à l'enseignant, à personne d'autre.
CODE_ACCES=

MAX_CARACTERES=2000
REQUETES_PAR_MINUTE=10
TEMPERATURE=0.2
DELAI_SECONDES=120
